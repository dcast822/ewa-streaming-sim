[0m18:59:10.301432 [debug] [Thread-1 (]: On model.ewa_pipeline.mart_employee_balances: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "ewa_pipeline", "target_name": "dev", "node_id": "model.ewa_pipeline.mart_employee_balances"} */

    

    create  table
      "ewa"."main"."mart_employee_balances__dbt_tmp"
  
    
    as (
      with confirmed_transactions as (

    select
        employee_id,
        employer_id,
        sum(amount) as total_confirmed_earnings

    from "ewa"."main"."int_transactions_deduped"
    where status = 'confirmed'
    group by employee_id, employer_id

),

approved_advances as (

    select
        employee_id,
        employer_id,
        sum(requested_amount) as total_approved_advances

    from "ewa"."main"."int_advance_requests"
    where status = 'approved'
    group by employee_id, employer_id

),

combined as (

    select
        coalesce(confirmed_transactions.employee_id, approved_advances.employee_id) as employee_id,
        coalesce(confirmed_transactions.employer_id, approved_advances.employer_id) as employer_id,
        coalesce(confirmed_transactions.total_confirmed_earnings, 0) as total_confirmed_earnings,
        coalesce(approved_advances.total_approved_advances, 0) as total_approved_advances

    from confirmed_transactions
    full outer join approved_advances
        on confirmed_transactions.employee_id = approved_advances.employee_id

)

select
    employee_id,
    employer_id,
    total_confirmed_earnings,
    total_approved_advances,
    total_confirmed_earnings - total_approved_advances as current_balance

from combined
    );
    
  
