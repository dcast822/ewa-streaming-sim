[0m19:57:22.064882 [debug] [Thread-1 (]: On model.ewa_pipeline.mart_employer_utilization: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "ewa_pipeline", "target_name": "dev", "node_id": "model.ewa_pipeline.mart_employer_utilization"} */

    

    create  table
      "ewa"."main"."mart_employer_utilization__dbt_tmp"
  
    
    as (
      with confirmed_transactions as (

    select
        employer_id,
        sum(amount) as total_earned_wages

    from "ewa"."main"."int_transactions_deduped"
    where status = 'confirmed'
        and date_trunc('month', event_time) = date_trunc('month', current_date)
    group by employer_id

),

approved_advances as (

    select
        employer_id,
        sum(requested_amount) as total_advances

    from "ewa"."main"."int_advance_requests"
    where status = 'approved'
        and date_trunc('month', request_time) = date_trunc('month', current_date)
    group by employer_id

),

combined as (

    select
        coalesce(
            confirmed_transactions.employer_id, approved_advances.employer_id
        ) as employer_id,
        coalesce(confirmed_transactions.total_earned_wages, 0) as total_earned_wages,
        coalesce(approved_advances.total_advances, 0) as total_advances

    from confirmed_transactions
    full outer join approved_advances
        on confirmed_transactions.employer_id = approved_advances.employer_id

)

select
    employer_id,
    total_earned_wages,
    total_advances,
    case
        when total_earned_wages = 0 then null
        else round((total_advances / total_earned_wages) * 100, 2)
    end as utilization_rate_pct

from combined
    );
    
  
